{
  "name": "@chapellu/intendance",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "banc": "node scripts/banc.mjs",
    "build": "tsc --noEmit && vite build",
    "catalogue": "python3 catalogue/export_json.py > public/cuisine-data.json",
    "catalogue:verifie": "python3 catalogue/verifier.py && npm run catalogue && git diff --exit-code -- public/cuisine-data.json",
    "dev": "vite",
    "e2e": "playwright test",
    "perf": "vite-node scripts/perf.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
